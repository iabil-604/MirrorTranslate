{
  "schemaVersion": 1,
  "minimum": {
    "sillytavern": null,
    "tavernHelper": null
  },
  "requirements": [
    {
      "id": "host-context",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext",
      "required": true,
      "fallback": null
    },
    {
      "id": "raw-generation",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().generateRaw",
      "required": true,
      "fallback": null
    },
    {
      "id": "message-render-refresh",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().updateMessageBlock",
      "required": true,
      "fallback": null
    },
    {
      "id": "independent-chat-completion-request",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().ChatCompletionService",
      "required": false,
      "fallback": "follow-current-connection"
    },
    {
      "id": "active-worldbook-context",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().getWorldInfoPrompt",
      "required": false,
      "fallback": "translate-without-worldbook"
    },
    {
      "id": "independent-model-list",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().getRequestHeaders",
      "required": false,
      "fallback": "manual-model-name"
    },
    {
      "id": "native-processing-regex",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().extensionSettings.regex",
      "required": false,
      "fallback": "save-profile-without-rendered-beautification"
    },
    {
      "id": "generation-interceptor",
      "owner": "sillytavern",
      "symbol": "manifest.generate_interceptor",
      "required": false,
      "fallback": "warn-and-recommend-disabling-auto-translation"
    },
    {
      "id": "native-chat-reload",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().reloadCurrentChat",
      "required": false,
      "fallback": "updateMessageBlock"
    },
    {
      "id": "read-aloud-cors-proxy",
      "owner": "sillytavern",
      "symbol": "/proxy/:url (config.yaml enableCorsProxy)",
      "required": false,
      "fallback": "direct-connection-to-a-cors-enabled-relay"
    },
    {
      "id": "native-extension-updater",
      "owner": "sillytavern",
      "symbol": "/api/extensions/discover + /api/extensions/version + /api/extensions/update",
      "required": false,
      "fallback": "use-sillytavern-extension-manager"
    },
    {
      "id": "helper-host-version",
      "owner": "sillytavern",
      "symbol": "/version",
      "required": false,
      "fallback": "omit-host-version-from-helper-context"
    },
    {
      "id": "helper-main-api",
      "owner": "sillytavern",
      "symbol": "SillyTavern.getContext().mainApi",
      "required": false,
      "fallback": "report-main-api-as-unknown"
    },
    {
      "id": "helper-stream-toggle",
      "owner": "sillytavern",
      "symbol": "#stream_toggle",
      "required": false,
      "fallback": "report-streaming-as-off"
    }
  ]
}
